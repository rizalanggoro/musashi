# Konfigurasi aplikasi backend MUSASHI
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
AUTO_MIGRATE=true

# Konfigurasi Database PostgreSQL (DBngin / Local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=musashi
DB_SSLMODE=disable

# Catatan DBngin:
# - Jika service PostgreSQL di DBngin tanpa password, kosongkan DB_PASSWORD:
#   DB_PASSWORD=
# - Opsi DATABASE_URL tunggal tetap didukung sebagai alternatif bila diisi.
