# Konfigurasi aplikasi backend MUSASHI
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
AUTO_MIGRATE=true

# Konfigurasi PostgreSQL (DBngin / Local)
# Buat database bernama 'musashi' terlebih dahulu di DBngin.
#
# Opsi 1: DBngin tanpa password (default jika password dikosongkan saat buat service):
# DATABASE_URL=postgres://postgres@localhost:5432/musashi?sslmode=disable
#
# Opsi 2: DBngin dengan password (default 'postgres'):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/musashi?sslmode=disable
